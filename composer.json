	"homepage": "https://wordpress.org/plugins/wp-email/",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Lester Chan",
			"email": "lesterchan@gmail.com"
		}
	],
	"require": {
		"php": ">=7.4"
